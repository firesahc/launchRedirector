<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Custom permission: only system apps or same-signature apps can read redirect config -->
    <permission
        android:name="com.example.launchRedirector.permission.READ_CONFIG"
        android:protectionLevel="signatureOrSystem" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LaunchRedirector" >

        <!-- LSPosed 标识 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true"/>

        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <meta-data
            android:name="xposeddescription"
            android:value="拦截小米桌面软件启动，跳转到自定义页面"/>

        <meta-data
            android:name="xposedminversion"
            android:value="89"/>

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".EditActivity" />

        <!-- authority must match ConfigProvider.AUTHORITY constant -->
        <provider
            android:name=".ConfigProvider"
            android:authorities="com.example.launchRedirector"
            android:exported="true"
            android:readPermission="com.example.launchRedirector.permission.READ_CONFIG" />

    </application>

</manifest>